DEPLOY_SERVER=user@your-server-ip
DEPLOY_DEST=/srv/dropfile
GO_BINARY_PATH=go

# --- Engage admin (/admin) ---
# HTTP Basic Auth credentials to reach /admin, plus a shared secret that both
# the Go server and the sidecar use to authorize admin API calls. Leave unset to
# disable /admin entirely (endpoints stay locked). ENGAGE_ADMIN_SECRET here MUST
# equal the one passed to the sidecar (docker-compose reads it from the shell/.env).
ADMIN_USER=admin
ADMIN_PASS=change-me
ENGAGE_ADMIN_SECRET=generate-a-long-random-string
