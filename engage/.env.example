# Postgres for the engage sidecar. Local dev default matches docker-compose (port 5433).
DATABASE_URL=postgres://postgres:postgres@localhost:5433/dropfile_engage

# --- Optional: email delivery (Brevo). Leave unset to disable emails; the
#     sidecar still stores every submission in Postgres. ---
# ENGAGE_API_KEY=your-brevo-api-key
# ENGAGE_ADMIN_EMAIL=hello@dropfile.dev
# ENGAGE_FROM_EMAIL=hello@dropfile.dev
# ENGAGE_FROM_NAME=dropfile
